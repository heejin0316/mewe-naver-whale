{
  "manifest_version": 3,
  "name": "ME:WE - 이화의 공부 탭 모음",
  "version": "0.3.1",
  "description": "열어둔 공부 페이지를 탭 모음으로 저장하고 필요할 때 다시 여는 네이버 웨일 사이드바 앱",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "sidebar_action": {
    "default_page": "sidebar.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "20": "assets/icons/icon20.png",
      "24": "assets/icons/icon24.png",
      "32": "assets/icons/icon32.png",
      "40": "assets/icons/icon40.png",
      "48": "assets/icons/icon48.png",
      "64": "assets/icons/icon64.png",
      "96": "assets/icons/icon96.png",
      "128": "assets/icons/icon128.png",
      "256": "assets/icons/icon256.png",
      "512": "assets/icons/icon512.png"
    },
    "default_title": "ME:WE",
    "use_navigation_bar": false
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon128.png",
    "64": "assets/icons/icon64.png",
    "96": "assets/icons/icon96.png",
    "128": "assets/icons/icon128.png",
    "256": "assets/icons/icon256.png",
    "512": "assets/icons/icon512.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  }
}
